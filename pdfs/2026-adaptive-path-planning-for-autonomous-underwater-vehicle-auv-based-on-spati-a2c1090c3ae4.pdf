<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>System Maintenance - MDPI</title>
    <style>
      /* Global Reset & Base Styles */
      body {
        margin: 0;
        padding: 0;
        font-family:
          -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
          "Helvetica Neue", Arial, sans-serif;
        background-color: #f7f8fa; /* Same light gray background as the login page */
        color: #333333;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
      }

      /* Top Logo Area */
      .logo-container {
        margin-bottom: 24px;
        text-align: center;
      }

      /* Text placeholder for Logo, replace with actual img tag */
      .logo-text {
        font-size: 24px;
        font-weight: 900;
        letter-spacing: 2px;
        border: 2px solid #333;
        padding: 4px 12px;
        position: relative;
      }

      /* Core Card Styling */
      .maintenance-card {
        background-color: #ffffff;
        width: 100%;
        max-width: 400px; /* Matches the login box width */
        padding: 40px;
        border-radius: 6px;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06); /* Soft shadow */
        box-sizing: border-box;
        text-align: center;
      }

      /* Title Styling */
      .maintenance-card h1 {
        font-size: 22px;
        font-weight: 500;
        margin-top: 0;
        margin-bottom: 16px;
        color: #1a1a1a;
      }

      /* Icon Placeholder */
      .icon-placeholder {
        margin-bottom: 20px;
        color: #8c9aa8;
      }
      .icon-placeholder svg {
        width: 64px;
        height: 64px;
        stroke: #b0bcc9;
        stroke-width: 1.5;
        fill: none;
      }

      /* Description Text */
      .maintenance-card p {
        font-size: 14px;
        color: #666666;
        line-height: 1.6;
        margin-bottom: 32px;
      }

      /* Button Styling (Exact replica of the original blue button) */
      .btn-primary {
        display: block;
        width: 100%;
        background-color: #1177c3; /* Original button blue */
        color: #ffffff;
        border: none;
        padding: 12px 0;
        font-size: 15px;
        border-radius: 4px;
        cursor: pointer;
        transition: background-color 0.2s ease;
        text-decoration: none;
        font-weight: 500;
      }

      .btn-primary:hover {
        background-color: #0d62a3; /* Darker blue on hover */
      }

      /* Footer Version */
      .version-footer {
        margin-top: 32px;
        font-size: 12px;
        color: #888888;
      }
    </style>
  </head>
  <body>
    <!-- Logo Area -->
    <div class="logo-container">
      <svg
        data-name="MDPI Logo V3"
        width="100"
        height="60"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 74.48 49.61"
      >
        <g>
          <path
            fill="#000000"
            d="m26.02,32.92h-4.64v-11.64l-3.03,11.64h-3.17l-3.12-11.64v11.64h-3.73v-16.28h6.52l2.37,8.64,2.25-8.64h6.57v16.28Z"
          ></path>
          <path
            fill="#000000"
            d="m28.88,16.64h6.3c2.68,0,4.52.71,6,2.29,1.42,1.51,2.17,3.54,2.17,5.81,0,4.86-3.2,8.18-7.86,8.18h-6.61v-16.28Zm6.3,12.55c1.73,0,2.95-1.83,2.95-4.42,0-1.17-.24-2.25-.73-3.1-.51-.9-1.24-1.34-2.22-1.34h-1.29v8.86h1.29Z"
          ></path>
          <path
            fill="#000000"
            d="m50.53,32.92h-5.05v-16.28h6.93c2.51,0,3.91.37,5.1,1.29,1.12.9,1.81,2.34,1.81,3.91,0,3.1-2.37,5.17-5.96,5.17h-2.83v5.91Zm1.61-9.4c1.51,0,2.2-.51,2.2-1.61,0-1.03-.68-1.54-2.05-1.54h-1.81v3.15h1.66Z"
          ></path>
          <path fill="#000000" d="m65.98,32.92h-5v-16.28h5v16.28Z"></path>
        </g>
        <g>
          <polygon
            fill="#000000"
            points="1.93 36.32 .71 36.32 .71 11.51 19.5 .71 38.42 11.48 37.27 12.22 19.5 2.11 1.93 12.22 1.93 36.32"
          ></polygon>
          <polygon
            fill="#000000"
            points="3.74 14.2 3.75 12.79 18.86 4.09 18.84 5.57 3.74 14.2"
          ></polygon>
        </g>
        <g>
          <polygon
            fill="#000000"
            points="72.55 13.29 73.77 13.29 73.77 38.09 54.98 48.9 36.06 38.13 37.21 37.39 54.98 47.49 72.55 37.39 72.55 13.29"
          ></polygon>
          <polygon
            fill="#000000"
            points="70.74 35.4 70.73 36.81 55.62 45.51 55.64 44.04 70.74 35.4"
          ></polygon>
        </g>
      </svg>
    </div>

    <!-- Maintenance Card -->
    <div class="maintenance-card">
      <!-- Visual Icon (Clock/Gear) -->
      <div class="icon-placeholder">
        <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
      </div>

      <h1>System Under Maintenance</h1>

      <p>
        We apologize for the inconvenience.<br />
        Our servers are currently undergoing scheduled upgrades and maintenance.
        We expect to be back shortly. Please try again later.
      </p>
    </div>
