<style>
#chatbot_bubble {
    position: fixed;
    bottom: 28px;
    right: 28px;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #293885;
    color: #fff;
    font-size: 26px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(0,0,0,0.25);
    z-index: 9999;
    transition: background 0.2s;
}
#chatbot_bubble:hover { background: #3A4E9E; }

#chatbot_window {
    display: none;
    flex-direction: column;
    position: fixed;
    bottom: 96px;
    right: 28px;
    width: 360px;
    height: 500px;
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 8px 30px rgba(0,0,0,0.18);
    z-index: 9998;
    overflow: hidden;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
}
#chatbot_window.open { display: flex; }

#chatbot_header {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: space-between;
    background: #293885;
    color: #fff;
    padding: 12px 16px;
    font-weight: 600;
    font-size: 15px;
}
#chatbot_header_actions { display: flex; align-items: center; gap: 8px; }

#chatbot_clear {
    background: none;
    border: 1px solid rgba(255,255,255,0.5);
    color: #fff;
    font-size: 11px;
    padding: 3px 8px;
    border-radius: 10px;
    cursor: pointer;
    opacity: 0.85;
    transition: opacity 0.2s;
}
#chatbot_clear:hover {
    opacity: 1;
    background: #3A4E9E;
}

#chatbot_close {
    background: none;
    border: none;
    color: #fff;
    font-size: 22px;
    cursor: pointer;
    line-height: 1;
}

#chatbot_messages {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: #f8f9fa;
}

.chatbot_msg_wrapper       { display: flex; flex-direction: column; }
.chatbot_msg_wrapper_user  { align-items: flex-end; }
.chatbot_msg_wrapper_bot   { align-items: flex-start; }

.chatbot_msg {
    max-width: 80%;
    padding: 9px 13px;
    border-radius: 16px;
    font-size: 14px;
    line-height: 1.5;
    word-wrap: break-word;
    white-space: pre-wrap;
}
.chatbot_msg_user {
    background: #293885;
    color: #fff;
    border-bottom-right-radius: 4px;
}
.chatbot_msg_bot {
    background: #fff;
    color: #212529;
    border: 1px solid #dee2e6;
    border-bottom-left-radius: 4px;
    white-space: normal;
}

/* Source attribution */
.chatbot_sources {
    font-size: 11px;
    color: #6c757d;
    margin-top: 4px;
    padding-left: 4px;
}

/* Markdown rendering inside bot messages */
.chatbot_msg_bot p             { margin: 0 0 8px 0; }
.chatbot_msg_bot p:last-child  { margin-bottom: 0; }
.chatbot_msg_bot ul,
.chatbot_msg_bot ol            { margin: 4px 0 8px 16px; padding: 0; }
.chatbot_msg_bot li            { margin-bottom: 4px; }
.chatbot_msg_bot strong        { font-weight: 600; }
.chatbot_msg_bot code          { background: #f1f3f5; padding: 1px 5px; border-radius: 4px; font-size: 13px; }
.chatbot_msg_bot pre           { background: #f1f3f5; padding: 10px; border-radius: 6px; overflow-x: auto; }
.chatbot_msg_bot h1,
.chatbot_msg_bot h2,
.chatbot_msg_bot h3            { font-size: 14px; font-weight: 600; margin: 8px 0 4px; }
.chatbot_msg_bot a             { color: #293885; text-decoration: underline; }
.chatbot_msg_bot a:hover       { color: #3A4E9E; }
.chatbot_link_ending          { white-space: nowrap; }

/* Typing indicator */
.chatbot_typing                { display: flex; gap: 5px; align-items: center; padding: 12px 14px; }
.chatbot_typing span           { width: 8px; height: 8px; background: #adb5bd; border-radius: 50%; animation: chatbot_bounce 1.2s infinite ease-in-out; }
.chatbot_typing span:nth-child(2) { animation-delay: 0.2s; }
.chatbot_typing span:nth-child(3) { animation-delay: 0.4s; }
@keyframes chatbot_bounce {
    0%, 80%, 100% { transform: scale(0.7); opacity: 0.5; }
    40%            { transform: scale(1.0); opacity: 1.0; }
}

#chatbot_footer {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 8px;
    padding: 10px 12px;
    border-top: 1px solid #dee2e6;
    background: #fff;
}
#chatbot_input {
    flex: 1;
    min-width: 0;
    resize: none;
    border: 1px solid #ced4da;
    border-radius: 8px;
    padding: 8px 10px;
    font-size: 14px;
    outline: none;
    font-family: inherit;
}
#chatbot_input:focus  { border-color: #293885; }
#chatbot_send {
    background: #293885;
    border: none;
    border-radius: 8px;
    color: #fff;
    padding: 8px 13px;
    font-size: 18px;
    cursor: pointer;
    transition: background 0.2s;
}
#chatbot_send:hover    { background: #3A4E9E; }
#chatbot_send:disabled { background: #adb5bd; cursor: default; }

@media only screen and (max-width: 864px) {
    #chatbot_bubble {
        right: 16px;
        bottom: 16px;
        bottom: calc(16px + env(safe-area-inset-bottom, 0px));
    }

    #chatbot_bubble.chatbot_open { display: none; }

    #chatbot_window {
        top: var(--chatbot-mobile-top, 12px);
        bottom: auto;
        left: 12px;
        right: 12px;
        width: auto;
        max-width: 360px;
        margin-left: auto;
        height: min(500px, calc(100vh - 24px));
        height: min(500px, var(--chatbot-mobile-height, calc(100dvh - 24px)));
    }

    #chatbot_header { padding: 8px 12px; gap: 8px; font-size: 14px; }
    #chatbot_header_actions { flex-shrink: 0; }
    #chatbot_clear { min-height: 44px; }
    #chatbot_close { min-width: 44px; min-height: 44px; }
    #chatbot_input { font-size: 16px; }
    #chatbot_send { min-height: 44px; }
}
