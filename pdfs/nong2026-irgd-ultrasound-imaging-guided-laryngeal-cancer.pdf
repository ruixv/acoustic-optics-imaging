	<script data-cfasync="false" src="/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script><script type='text/javascript' src='/assets/js/jquery-3.3.1.min.js'></script>
<script type='text/javascript' src='/assets/js/jquery-ui-1.10.4.custom.min.js'></script>
<script type='text/javascript' src='/assets/js/functions_v7.js?v=1793257041'></script>
<script type='text/javascript' src='/assets/js/addon/jquery.formtools.js' defer ></script>
<script type='text/javascript' src='/assets/js/addon/jquery.popupBox.min.js' defer ></script>
<script type='text/javascript' src='/assets/js/jquery.news_ticker.min.js' defer ></script>
<script type='text/javascript' src='/assets/js/jquery.fitvids.js'></script>

<span id='javascript-insert-point'></span>

<script type='text/javascript'>
function addJS(url, is_defer, is_async){
	is_defer = is_defer || false;
	is_async = is_async || false;
	var insertPoint = document.getElementById('javascript-insert-point');
	var element = document.createElement('script');
	element.src = url;
	element.defer = is_defer;
	element.async = is_async;
	insertPoint.appendChild(element);
}

function downloadJSAtOnload(){
	addJS('/assets/js/main_v7.js?v=3', true, false);
	addJS('/assets/js/addon/addon_v5.js', true, false);
	addJS('https://d1bxh8uas1mnw7.cloudfront.net/assets/embed.js', true, false);
	addJS('/assets/js/addon/article.js', true, false);
}

if (window.addEventListener) {
	window.addEventListener('load', downloadJSAtOnload, false);
} else if (window.attachEvent) {
	window.attachEvent('onload', downloadJSAtOnload);
} else {
	window.onload = downloadJSAtOnload;
}

</script>
<script>
    $(document).ready(function () {
        const apiUrl = (typeof site_url !== 'undefined' ? site_url : '/') + 'api/caller.php';
        let hasChatbotConversation = false;

        // Keep the input and close button inside the visible area above a phone's keyboard.
        function updateMobileChatbotViewport() {
            const chatWindow = document.getElementById('chatbot_window');
            const viewport = window.visualViewport;
            if (!viewport) return;

            if (!window.matchMedia('(max-width: 864px)').matches) {
                chatWindow.style.removeProperty('--chatbot-mobile-top');
                chatWindow.style.removeProperty('--chatbot-mobile-height');
                return;
            }

            chatWindow.style.setProperty('--chatbot-mobile-top', (viewport.offsetTop + 12) + 'px');
            chatWindow.style.setProperty('--chatbot-mobile-height', Math.max(0, viewport.height - 24) + 'px');
        }

        if (window.visualViewport) {
            window.visualViewport.addEventListener('resize', updateMobileChatbotViewport);
            window.visualViewport.addEventListener('scroll', updateMobileChatbotViewport);
            window.addEventListener('resize', updateMobileChatbotViewport);
            updateMobileChatbotViewport();
        }

        $('#chatbot_bubble').on('click', function () {
            $('#chatbot_window').toggleClass('open');
            $('#chatbot_bubble').toggleClass('chatbot_open', $('#chatbot_window').hasClass('open'));
            updateMobileChatbotViewport();

            if (!$('#chatbot_window').hasClass('open')) {
                notifyChatbotConversation();
            }

            if ($('#chatbot_window').hasClass('open') && $('#chatbot_messages').children().length === 0) {
                $.getJSON(apiUrl, { request: 'chatbot/get_history' }, function (response) {
                    if (response.success && response.history.length > 0) {
                        hasChatbotConversation = true;
                        for (let i = 0; i < response.history.length; i += 2) {
                            const user_entry  = response.history[i];
                            const model_entry = response.history[i + 1];

                            if (user_entry)  appendChatbotMessage('user', user_entry.text);
                            if (model_entry) appendChatbotMessage('bot',  model_entry.text);
                        }
                    } else {
                        appendChatbotMessage('bot', 'Welcome to the Dove Medical Press help desk. I can assist you with inquiries regarding author submissions, peer review guidelines, editorial policies, or publishing with us. How may I help you today?');
                    }
                });
            }
        });

        $('#chatbot_close').on('click', function (e) {
            e.stopPropagation();
            $('#chatbot_window').removeClass('open');
            $('#chatbot_bubble').removeClass('chatbot_open');
            document.getElementById('chatbot_input').blur();
            notifyChatbotConversation();
        });

        // Also finish chats when navigating away or closing the browser tab.
        // The server reads the transcript from the session, never from this request.
        window.addEventListener('pagehide', function () {
            if (!hasChatbotConversation) return;
            const url = apiUrl + '?request=chatbot/end_chat';
            if (navigator.sendBeacon && navigator.sendBeacon(url, new URLSearchParams())) return;
            if (typeof fetch === 'function') {
                fetch(url, { method: 'POST', credentials: 'same-origin', keepalive: true }).catch(function () {});
            }
        });

        function notifyChatbotConversation() {
            if (!hasChatbotConversation) return;
            $.post(apiUrl + '?request=chatbot/end_chat', {}, null, 'json');
        }

        $('#chatbot_clear').on('click', function () {
            $.post(apiUrl + '?request=chatbot/clear_history', {}, function () {
                hasChatbotConversation = false;
                $('#chatbot_messages').empty();
                appendChatbotMessage('bot', 'History cleared. How can I help you?');
            }, 'json');
        });

        $('#chatbot_send').on('click', function () {
            sendChatbotMessage();
        });

        $('#chatbot_input').on('keydown', function (e) {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                sendChatbotMessage();
            }
        });

        function sendChatbotMessage() {
            const user_question = $('#chatbot_input').val().trim();
            if (!user_question) return;

            hasChatbotConversation = true;

            appendChatbotMessage('user', user_question);
            $('#chatbot_input').val('');
            setInputState(false);
            showTypingIndicator();

            $.post(apiUrl + '?request=chatbot/send_message', { question: user_question }, function (response) {
                hideTypingIndicator();
                setInputState(true);

                if (response.timeout) {
                    appendChatbotMessage('bot', 'The assistant is taking too long to respond. Please try again in a moment.');
                    return;
                }

                if (response.success) {
                    appendChatbotMessage('bot', response.answer, response.sources);
                } else {
                    appendChatbotMessage('bot', response.message || 'Something went wrong. Please try again.');
                }
            }, 'json').fail(function () {
                hideTypingIndicator();
                setInputState(true);
                appendChatbotMessage('bot', 'Failed to reach the assistant server. Please check that the backend embedder service is running.');
            });
        }

        function appendChatbotMessage(sender, text, sources = []) {
            const message_class = (sender === 'user') ? 'chatbot_msg_user' : 'chatbot_msg_bot';
            const $wrapper      = $('<div>').addClass('chatbot_msg_wrapper chatbot_msg_wrapper_' + sender);
            const $message      = $('<div>').addClass('chatbot_msg ' + message_class);

            if (sender === 'bot') {
                if (typeof marked !== 'undefined') {
                    $message.html(marked.parse(text));
                } else {
                    $message.text(text);
                }

                $message.find('a[href]')
                    .attr('target', '_blank')
                    .attr('rel', 'noopener noreferrer')
                    .each(function () {
                        // Keep trailing punctuation with the link's final character,
                        // while still allowing the rest of a long URL to wrap.
                        const next = this.nextSibling;
                        if (next && next.nodeType === Node.TEXT_NODE) {
                            const punctuation = next.textContent.match(/^\s*([.,;:!?]+)/);
                            if (!punctuation) return;

                            const walker = document.createTreeWalker(this, NodeFilter.SHOW_TEXT);
                            let lastText = null;
                            while (walker.nextNode()) {
                                if (walker.currentNode.textContent) lastText = walker.currentNode;
                            }
                            if (!lastText) return;

                            const ending = document.createElement('span');
                            ending.className = 'chatbot_link_ending';
                            ending.textContent = lastText.textContent.slice(-1) + punctuation[1];
                            lastText.textContent = lastText.textContent.slice(0, -1);
                            lastText.parentNode.insertBefore(ending, lastText.nextSibling);
                            next.textContent = next.textContent.slice(punctuation[0].length);
                        }
                    });

                // if (sources && sources.length > 0) {
                //     const $sourcesDiv = $('<div>').addClass('chatbot_sources').text('Learn more: ');
                //
                //     sources.forEach(function (source, index) {
                //         const $link = $('<a>')
                //             .attr('href', source.url)
                //             .attr('target', '_blank')
                //             .attr('rel', 'noopener noreferrer')
                //             .text(source.label);
                //
                //         $sourcesDiv.append($link);
                //         if (index < sources.length - 1) {
                //             $sourcesDiv.append(', ');
                //         }
                //     });
                //
                //     $message.append($sourcesDiv);
                // }
            } else {
                $message.text(text);
            }

            $wrapper.append($message);
            $('#chatbot_messages').append($wrapper);
            scrollToChatbotMessage();
        }

        function showTypingIndicator() {
            const indicator = $('<div>')
                .attr('id', 'chatbot_typing')
                .addClass('chatbot_msg chatbot_msg_bot chatbot_typing')
                .html('<span></span><span></span><span></span>');
            $('#chatbot_messages').append(indicator);
            scrollToChatbotBottom();
        }

        function hideTypingIndicator() {
            $('#chatbot_typing').remove();
        }

        function setInputState(enabled) {
            // Keep textarea auto-focus and sizing comfortable
            $('#chatbot_input, #chatbot_send').prop('disabled', !enabled);
            if (enabled) {
                $('#chatbot_input').focus();
            }
        }

        function scrollToChatbotMessage() {
            const messages = $('#chatbot_messages');
            const lastMessage = messages.find('.chatbot_msg_wrapper').last();

            if (lastMessage.length) {
                const messageOffset = lastMessage[0].offsetTop - 60;
                messages.scrollTop(messageOffset);
            }
        }

        function scrollToChatbotBottom() {
            const messages = $('#chatbot_messages');
            messages.scrollTop(messages[0].scrollHeight);
        }
    });
</script>

<script>
    $(() => {
        $.ajaxSetup({
            cache: true,
        });
        $('#rs_req_Init').load("https://cdn-eu.readspeaker.com/script/12838/webReader/webReader.js?pids=wr", (response, status, jqxhr) => {
            if(status === 'success'){
                var apiEndPoint = new URL('https://app-eu.readspeaker.com/cgi-bin/rsent'),
                    params = {
                        customerid: 12838,
                        lang: 'en_us',
                        voice: 'Ashley',
                        readid: 'html-readaloud-text',
                        url: 'https%3A%2F%2Fwww.dovepress.com%2Firgd-functionalized-phase-change-liposomal-nanodroplets-for-ultrasound-peer-reviewed-fulltext-article-IJN',
                        // stattype: 'default', // category
                        // can now use shorter-urls for stats only. max_len is 200
                        statparam: 'https%3A%2F%2Fwww.dovepress.com%2Firgd-functionalized-phase-change-liposomal-nanodroplets-for-ultrasound-peer-reviewed-fulltext-article-IJN',
                    };

                apiEndPoint.search = new URLSearchParams(params);

                // var finalURL = apiEndPoint.toString();

                //inject logging here?

                $('.rsbtn_play').prop('href', apiEndPoint.toString());
                $("#btn-readspeaker").removeClass('hide');
            }

        });
    });
</script>

</body>
