	<script>
		// helper to get cookie value
		function getCookie(name) {
            return document.cookie
                .split('; ')
                .find(row => row.startsWith(name + '='))
                ?.split('=')[1];
        }

		
        function refreshLocalStorage() {
            let session_cookie = getCookie("session_change");

			// checks if "session_change" is absent, was changed in the backend or expired
            if (
                window.localStorage.getItem('session_change') === null ||
                window.localStorage.getItem('session_change') === undefined ||
                window.localStorage.getItem('session_change') != session_cookie
            ) {
				// Unset cached sidebars
                window.localStorage.removeItem('logged_in_menu_desktop');
                window.localStorage.removeItem('logged_in_menu_mobile');

				// Cookie is absent (If user visits the site without any local storage, or backend hasn't generated one yet) Create a cookie
                if (session_cookie === null || session_cookie === undefined) {
                    session_cookie = Array(32).fill(0).map(() =>
                        Math.floor(Math.random() * 16).toString(16)
                    ).join('');

					// Set new cookie
                    document.cookie = "session_change=" + session_cookie
									+ "; expires=" + new Date(new Date().getTime() + 3 * 60 * 1000).toUTCString()
									+ "; path=/";

                }

				// Record cookie value into local storage so we can confirm when it changes
                window.localStorage.setItem('session_change', session_cookie);

                // Let later ajax know cache was invalidated
                window.sidebarCacheInvalidated = true;
                return true;
            } else {
				// No need to refresh the sidebar
				window.sidebarCacheInvalidated = false;
				return false;
			}

        }

        refreshLocalStorage();
	</script>
